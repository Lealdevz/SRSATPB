@page
@model ATPBCauaLeal.Pages.Admin.CursosModel

@{
    ViewData["Title"] = "Cursos";
}

<h2 class="mb-4">Cursos</h2>

@if (Model.MensagemSucesso is not null)
{
    <div class="alert alert-success" role="alert">
        @Model.MensagemSucesso
    </div>
}

@if (Model.MensagemErro is not null)
{
    <div class="alert alert-danger" role="alert">
        @Model.MensagemErro
    </div>
}

<div class="card shadow-sm p-3 mb-4">
    <h5 class="mb-3">Novo curso</h5>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Nome" class="form-label">Nome</label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CargaHorariaMinima" class="form-label">Carga horaria minima</label>
                <input asp-for="CargaHorariaMinima" class="form-control" />
                <span asp-validation-for="CargaHorariaMinima" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                Cadastrar
            </button>
        </div>
    </form>
</div>

<div class="card shadow-sm p-3">
    <h5 class="mb-3">Cursos cadastrados</h5>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>Nome</th>
                <th>Carga horaria minima</th>
                <th class="text-end">Acoes</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var curso in Model.Cursos)
            {
                <tr>
                    <td>@curso.Nome</td>
                    <td>@curso.CargaHorariaMinima horas</td>
                    <td class="text-end">
                        <a asp-page="/Admin/EditarCurso"
                           asp-route-id="@curso.Id"
                           class="btn btn-sm btn-outline-primary">
                            Editar
                        </a>

                        <form method="post"
                              asp-page-handler="Excluir"
                              asp-route-id="@curso.Id"
                              class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Excluir
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
