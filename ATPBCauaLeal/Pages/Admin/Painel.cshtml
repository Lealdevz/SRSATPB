@page
@model ATPBCauaLeal.Pages.Admin.PainelModel

@{
    ViewData["Title"] = "Painel Administrativo";
}

<h2 class="mb-4">Painel Administrativo</h2>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm p-3">
            <h6 class="text-muted">Alunos</h6>
            <h4>@Model.TotalAlunos</h4>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm p-3">
            <h6 class="text-muted">Professores</h6>
            <h4>@Model.TotalProfessores</h4>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm p-3">
            <h6 class="text-muted">Administradores</h6>
            <h4>@Model.TotalAdministradores</h4>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6 class="text-muted">Cursos</h6>
            <h4>@Model.TotalCursos</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6 class="text-muted">Disciplinas</h6>
            <h4>@Model.TotalDisciplinas</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6 class="text-muted">Turmas</h6>
            <h4>@Model.TotalTurmas</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6 class="text-muted">Planos de Estudos</h6>
            <h4>@Model.TotalPlanos</h4>
        </div>
    </div>
</div>
