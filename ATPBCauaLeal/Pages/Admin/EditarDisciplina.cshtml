@page
@model ATPBCauaLeal.Pages.Admin.EditarDisciplinaModel

@{
    ViewData["Title"] = "Editar disciplina";
}

<h2 class="mb-4">Editar disciplina</h2>

<div class="card shadow-sm p-3">
    <form method="post">
        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CursoId" class="form-label">Curso</label>
            <select asp-for="CursoId" asp-items="Model.Cursos" class="form-select">
                <option value="">Selecione</option>
            </select>
            <span asp-validation-for="CursoId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Codigo" class="form-label">Código</label>
            <input asp-for="Codigo" class="form-control" />
            <span asp-validation-for="Codigo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome</label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CargaHoraria" class="form-label">Carga horária</label>
            <input asp-for="CargaHoraria" class="form-control" />
            <span asp-validation-for="CargaHoraria" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="Obrigatoria" class="form-check-input" />
            <label asp-for="Obrigatoria" class="form-check-label">Disciplina obrigatória</label>
        </div>

        <button type="submit" class="btn btn-primary">
            Salvar
        </button>

        <a asp-page="/Admin/Disciplinas" class="btn btn-outline-secondary">
            Cancelar
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
