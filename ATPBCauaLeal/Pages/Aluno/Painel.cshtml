@page
@model ATPBCauaLeal.Pages.Aluno.PainelModel

@{
    ViewData["Title"] = "Painel do Aluno";
}

<h2 class="mb-4">Painel do Aluno</h2>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6 class="text-muted">Status da Matrícula</h6>
            <h4 class="text-success">Ativa</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6 class="text-muted">Plano de Estudos</h6>
            <h4>@(Model.PossuiPlano ? "Sim" : "Não")</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6 class="text-muted">Disciplinas Concluídas</h6>
            <h4>@Model.DisciplinasConcluidas</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6 class="text-muted">Disciplinas Faltantes</h6>
            <h4>@Model.DisciplinasFaltantes</h4>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6 class="text-muted">Orientador</h6>
            <h4>@Model.NomeOrientador</h4>
        </div>
    </div>
</div>
