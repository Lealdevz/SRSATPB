@page
@model ATPBCauaLeal.Pages.Aluno.PlanoDeEstudosModel

@{
    ViewData["Title"] = "Plano de Estudos";
}

<h2 class="mb-4">Plano de Estudos</h2>

@if (Model.MensagemSucesso is not null)
{
    <div class="alert alert-success" role="alert">
        @Model.MensagemSucesso
    </div>
}

@if (Model.MensagemErro is not null)
{
    <div class="alert alert-danger" role="alert">
        @Model.MensagemErro
    </div>
}

@if (Model.NomeCurso is not null)
{
    <form method="post">
        <div class="card shadow-sm p-3 mb-4">
            <h5 class="mb-3">Disciplinas obrigatórias</h5>

            <p class="text-muted mb-3">
                Informe as disciplinas que você já concluiu para que o sistema monte uma sugestão de plano com o que ainda falta cursar.
            </p>

            <p class="mb-3">
                Curso: <strong>@Model.NomeCurso</strong>
            </p>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Já concluí</th>
                        <th>Código</th>
                        <th>Disciplina</th>
                        <th>Carga horária</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var disciplina in Model.DisciplinasObrigatorias)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="DisciplinasConcluidas"
                                       value="@disciplina.Id"
                                       checked="@disciplina.Concluida" />
                            </td>
                            <td>@disciplina.Codigo</td>
                            <td>@disciplina.Nome</td>
                            <td>@disciplina.CargaHoraria horas</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm p-3">
            <h5 class="mb-3">Disciplinas optativas</h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Já concluí</th>
                        <th>Código</th>
                        <th>Disciplina</th>
                        <th>Carga horária</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var disciplina in Model.DisciplinasOptativas)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="DisciplinasConcluidas"
                                       value="@disciplina.Id"
                                       checked="@disciplina.Concluida" />
                            </td>
                            <td>@disciplina.Codigo</td>
                            <td>@disciplina.Nome</td>
                            <td>@disciplina.CargaHoraria horas</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                Montar plano de estudos
            </button>
        </div>
    </form>
}
