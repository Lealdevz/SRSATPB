@page
@model ATPBCauaLeal.Pages.Aluno.PlanoMontadoModel

@{
    ViewData["Title"] = "Plano Montado";
}

<h2 class="mb-4">Plano Montado</h2>

<div class="card shadow-sm p-3 mb-4">
    <h5 class="mb-3">Resumo</h5>

    <p class="mb-0">
        Carga horária faltante: <strong>@Model.CargaHorariaFaltante horas</strong>
    </p>
</div>

<div class="card shadow-sm p-3 mb-4">
    <h5 class="mb-3">Obrigatórias faltantes</h5>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>Código</th>
                <th>Disciplina</th>
                <th>Carga horária</th>
                <th class="text-end">Ações</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var disciplina in Model.ObrigatoriasFaltantes)
            {
                <tr>
                    <td>@disciplina.Codigo</td>
                    <td>@disciplina.Nome</td>
                    <td>@disciplina.CargaHoraria horas</td>
                    <td class="text-end">
                        <a asp-page="/Aluno/TurmasDisciplina"
                           asp-route-disciplinaId="@disciplina.Id"
                           class="btn btn-sm btn-outline-primary">
                            Turmas
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm p-3">
    <h5 class="mb-3">Optativas faltantes</h5>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>Código</th>
                <th>Disciplina</th>
                <th>Carga horária</th>
                <th class="text-end">Ações</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var disciplina in Model.OptativasFaltantes)
            {
                <tr>
                    <td>@disciplina.Codigo</td>
                    <td>@disciplina.Nome</td>
                    <td>@disciplina.CargaHoraria horas</td>
                    <td class="text-end">
                        <a asp-page="/Aluno/TurmasDisciplina"
                           asp-route-disciplinaId="@disciplina.Id"
                           class="btn btn-sm btn-outline-primary">
                            Turmas
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-page="/Aluno/PlanoDeEstudos"
       asp-route-editar="true"
       class="btn btn-outline-secondary">
        Alterar disciplinas cursadas
    </a>
</div>
