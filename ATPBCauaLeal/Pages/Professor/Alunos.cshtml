@page
@model ATPBCauaLeal.Pages.Professor.AlunosModel

@{
    ViewData["Title"] = "Alunos do Professor";
}

<h2 class="mb-4">Alunos</h2>

<div class="card shadow-sm p-3">
    <h5>Alunos Orientados</h5>

    @if (Model.Alunos.Count == 0)
    {
        <div class="alert alert-info mb-0">
            Você ainda não possui alunos vinculados como orientador.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                <tr>
                    <th>Nome</th>
                    <th>Login</th>
                    <th>Curso</th>
                    <th>Possui Plano de Estudo</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var aluno in Model.Alunos)
                {
                    <tr>
                        <td>@aluno.Nome</td>
                        <td>@aluno.Login</td>
                        <td>@aluno.Curso</td>
                        <td>
                            @if (aluno.PossuiPlanoDeEstudo)
                            {
                                <span class="badge bg-success">Sim</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Não</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
